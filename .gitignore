# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Experiment tracking
wandb/

# Hugging Face cache (models/datasets should not live in the repo)
.cache/
huggingface_cache/

# Large artifacts
*.bin
*.safetensors
*.pt
*.ckpt
checkpoints/

# Experiment checkpoints saved under results/<run>/ (CLAUDE.md: "Do not
# commit large checkpoints to Git"). Only config.json/metrics.json/notes.md
# per run are tracked -- everything a trainer.save_model() call writes
# alongside them (adapter weights, full tokenizer copy, training_args.bin,
# auto-generated README) stays local.
results/*/adapter_*
results/*/tokenizer*
results/*/chat_template.jinja
results/*/training_args.bin
results/*/README.md
results/*/*.safetensors

# Data / notebooks checkpoints
data/*
!data/.gitkeep
.ipynb_checkpoints/

# OS cruft
.DS_Store

# Editor
.vscode/
.idea/

# Env files
.env
